     <html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <style>
    .custom-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: stretch;
    }

    .custom-col {
      flex: 1 1 calc(25% - 20px); /* Adjust percentage to fit 4 boxes in a row */
      max-width: calc(25% - 20px);
      box-sizing: border-box;
      padding: 1px; /* Increased padding */
      margin: 10px; /* Increased margin */
      
    }

    .custom-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding: 20px;
  border: 2px solid #ccc; /* Example border: 2px solid gray */
  background-color: #f0f0f0;
  border-radius: 10px;
  height: 100%;
}


    .custom-card-content {
      display: flex;
      align-items: center;
      text-align: left;
    }

    .custom-card img {
      width: 60px;
      height: 60px; /* Equal width and height for a perfect circle */
      border-radius: 50%;
      border: 1px solid black;
    }

    .custom-card-text {
      margin-left: 10px;
    }

    .custom-card-text p {
      margin: 0;
    }

    .custom-card-text .username {
      font-weight: bold;
      font-size: 18px;
    }

    .custom-card-text .welcome-message {
      font-size: 16px;
      color: black;
    }

    @media (max-width: 768px) {
      .custom-col {
        flex: 1 1 calc(50% - 20px); /* Adjust percentage to fit 2 boxes in a row */
        max-width: calc(50% - 20px);
      }
    }

    @media (max-width: 480px) {
      .custom-col {
        flex: 1 1 100%; /* Stack boxes vertically */
        max-width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="custom-row">
    <div class="custom-col">
      <div class="custom-card">
        <div class="custom-card-content">
          <img src="https://i.postimg.cc/JnryHgbD/management-consulting.gif" alt="gif">
          <div class="custom-card-text">
            <p class="username">{{ user["username"] }}</p>
            <p class="welcome-message">Welcome to {{ site["site_name"] }}!</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="custom-col">
      <div class="custom-card">
        <div class="custom-card-content">
          <img src="https://c.tenor.com/o7xzZ5dqClMAAAAC/money-love.gif" alt="gif">
          <div class="custom-card-text">
            <p class="username">{{totalorders}}</p>
            <p class="welcome-message">Total Orders</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="custom-col">
      <div class="custom-card">
        <div class="custom-card-content">
          <img src="https://www.bootgum.com/wp-content/uploads/2018/07/Wallet_Cash_550px.gif" alt="gif">
          <div class="custom-card-text">
            <p class="username">{{ user["balance"] }}</p>
            <p class="welcome-message">Total Balance</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="custom-col">
      <div class="custom-card">
        <div class="custom-card-content">
          <img src="https://c.tenor.com/XW-LgnkZQ28AAAAC/shopping-online.gif" alt="gif">
          <div class="custom-card-text">
            <p class="username">{{ user["spent"] }}</p>
            <p class="welcome-message">Total Spend</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
